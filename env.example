# GitHub Gist 配置

# 報到設定同步 Gist
# 用於同步報到開關和截止時間設定
VITE_GIST_ID=your_settings_gist_id_here

# 報到數據集中存儲 Gist（新增）
# 用於集中存儲所有用戶的報到記錄
VITE_CHECKIN_GIST_ID=your_checkin_data_gist_id_here

# GitHub Personal Access Token - 需要 "gist" 權限
# 從 GitHub Settings > Developer settings > Personal access tokens 創建
# 兩個 Gist 可以使用相同的 Token
VITE_GITHUB_TOKEN=ghp_your_token_here

# 設置說明：
# 1. 複製此文件並重命名為 .env.local
# 2. 按照 GITHUB_GIST_SETUP.md 的指引獲取 Gist ID 和 Token
# 3. 填入上方的實際值
# 4. 在 Vercel 部署時，需在 Project Settings > Environment Variables 中添加相同的變數

